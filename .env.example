# JiraRush environment configuration — example
# Copy to .env and fill in real values. The .env file is git-ignored.
# application.yaml reads these via ${VAR:default} placeholders.

# PostgreSQL (dev / prod)
DB_URL=jdbc:postgresql://localhost:5432/jira
DB_USERNAME=jira
DB_PASSWORD=change-me

# PostgreSQL (tests)
TEST_DB_URL=jdbc:postgresql://localhost:5433/jira-test
TEST_DB_USERNAME=jira
TEST_DB_PASSWORD=change-me

# OAuth2 — GitHub
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# OAuth2 — Google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# OAuth2 — VK
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=

# OAuth2 — Yandex
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=

# OAuth2 — GitLab
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=

# Mail (Gmail SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=
